{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmadbuilds/SlopGuard/blob/main/src/slopguard/schemas/dependency-result.schema.json",
  "title": "SlopGuard dependency result",
  "description": "Versioned result contract for one requested PyPI dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "requested_name",
    "normalized_name",
    "registry_exists",
    "metadata_evidence",
    "similarity_candidates",
    "risk_score",
    "severity",
    "remediation"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "1.0.0"},
    "requested_name": {"type": "string", "minLength": 1},
    "normalized_name": {
      "type": "string",
      "minLength": 1,
      "description": "PEP 503 canonicalized name: lowercase with runs of '.', '_' and '-' replaced by '-'."
    },
    "registry_exists": {
      "type": ["boolean", "null"],
      "description": "True or false only after a successful lookup; null when lookup could not establish the answer."
    },
    "metadata_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/metadataEvidence"}
    },
    "similarity_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/similarityCandidate"}
    },
    "risk_score": {"type": "number", "minimum": 0, "maximum": 100},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "remediation": {"type": "string", "minLength": 1},
    "registry_status": {
      "enum": ["exists", "not_found", "transient_error", "malformed_response"]
    },
    "registry_metadata": {"$ref": "#/$defs/registryMetadata"},
    "registry_diagnostics": {"$ref": "#/$defs/registryDiagnostics"},
    "score_contributions": {
      "type": "array",
      "items": {"$ref": "#/$defs/scoreContribution"}
    },
    "decision": {"enum": ["pass", "warn", "block"]},
    "allowlisted": {"type": "boolean"},
    "source_locations": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceLocation"}
    }
  },
  "$defs": {
    "metadataEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "source", "confidence"],
      "properties": {
        "kind": {
          "enum": ["registry_metadata", "maintainer", "release_history", "similarity", "other"]
        },
        "summary": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "similarityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "similarity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "registry_exists": {"type": ["boolean", "null"]},
        "edit_distance": {"type": "integer", "minimum": 0},
        "popularity_rank": {"type": "integer", "minimum": 1},
        "match_kind": {"enum": ["edit", "separator"]}
      }
    },
    "scoreContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "points", "summary"],
      "properties": {
        "signal": {
          "enum": ["not_found", "lookalike", "new_package", "few_releases", "missing_source"]
        },
        "points": {"type": "number"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "source_type"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "source_type": {"enum": ["requirements", "pyproject", "import"]}
      }
    },
    "registryMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_release_at",
        "release_count",
        "latest_release_at",
        "project_urls",
        "maintainer_hints",
        "source_hints"
      ],
      "properties": {
        "first_release_at": {"type": ["string", "null"], "format": "date-time"},
        "release_count": {"type": ["integer", "null"], "minimum": 0},
        "latest_release_at": {"type": ["string", "null"], "format": "date-time"},
        "project_urls": {
          "type": "object",
          "additionalProperties": {"type": "string", "format": "uri"}
        },
        "maintainer_hints": {"type": "array", "items": {"type": "string"}},
        "source_hints": {"type": "array", "items": {"type": "string", "format": "uri"}}
      }
    },
    "registryDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_ms",
        "attempts",
        "http_status",
        "retry_after",
        "rate_limit_remaining",
        "error"
      ],
      "properties": {
        "latency_ms": {"type": "number", "minimum": 0},
        "attempts": {"type": "integer", "minimum": 1},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "retry_after": {"type": ["string", "null"]},
        "rate_limit_remaining": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
